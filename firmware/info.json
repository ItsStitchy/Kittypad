{
    "keyboard_name": "Kittypad",
    "manufacturer": "stitchy",
    "url": "https://github.com/ItsStitchy/Kittypad",
    "maintainer": "stitchy",
    "processor": "RP2040",
    "bootloader": "rp2040",
    "usb": {
        "vid": "0xFEED",
        "pid": "0x6060",
        "device_version": "0.0.1"
    },
    "matrix_pins": {
        "direct": [
            ["GP10", "GP9", "GP8", "GP7", "GP2"]
        ]
    },
    "encoder": {
        "rotary": [
            {"pin_a": "GP0", "pin_b": "GP1"}
        ]
    },
    "rgblight": {
        "pin": "GP6",
        "led_count": 1,
        "driver": "ws2812"
    },
    "layouts": {
        "LAYOUT_ortho_5key": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0},
                {"matrix": [0, 1], "x": 1, "y": 0},
                {"matrix": [0, 2], "x": 0, "y": 1},
                {"matrix": [0, 3], "x": 1, "y": 1},
                {"matrix": [0, 4], "x": 0.5, "y": 2}
            ]
        }
    }
}
